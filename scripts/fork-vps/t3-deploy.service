[Unit]
Description=Deploy the newest T3 Code fork main
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
# A stuck build must not block the next timer runs.
TimeoutStartSec=45min
# Production apps on the same box come first. Above MemoryHigh the kernel slows the
# build down instead of letting it take the memory of the other apps.
CPUWeight=10
IOWeight=10
Nice=10
MemoryHigh=6G
ExecStart=/opt/t3code/scripts/fork-vps/deploy.sh
