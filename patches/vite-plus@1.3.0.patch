@@ -0,0 +1,39 @@
+import { readFile, access } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+async function readJson(file) {
+  try { return JSON.parse(await readFile(file, 'utf8')); }
+  catch (error) { if (error.code !== 'ENOENT') throw error; }
+}
+
+// Optional repository integration; never changes the task runner's exit status.
+export async function startRunHook(command, cwd = process.cwd()) {
+  if (command !== 'run') return;
+  try {
+    const configured = await readJson(path.join(os.homedir(), '.config/vite-plus/run-hook.json'));
+    let root = cwd;
+    while (true) {
+      const manifest = await readJson(path.join(root, 'package.json'));
+      let hook = manifest?.vitePlus?.runHook;
+      if (!hook && configured?.rootMarker && configured?.module) {
+        try { await access(path.join(root, configured.rootMarker)); hook = configured.module; }
+        catch (error) { if (error.code !== 'ENOENT') throw error; }
+      }
+      if (typeof hook === 'string') {
+        const integration = await import(pathToFileURL(path.resolve(root, hook)).href);
+        const finish = await integration.default({ root });
+        return async () => {
+          try { await finish?.(); }
+          catch { console.warn('[Vite+] Run hook failed to finish.'); }
+        };
+      }
+      const parent = path.dirname(root);
+      if (parent === root) return;
+      root = parent;
+    }
+  } catch {
+    console.warn('[Vite+] Run hook failed to start.');
+  }
+}
