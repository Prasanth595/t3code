@@ -0,0 +1,36 @@
+#pragma once
+#import <Foundation/Foundation.h>
+#import <TargetConditionals.h>
+#if TARGET_OS_OSX
+#import <AppKit/AppKit.h>
+#else
+#import <UIKit/UIKit.h>
+#endif
+
+// Explicit direction marks win; otherwise count letters, with LTR winning ties.
+static NSWritingDirection ENRMMajorityTextDirection(NSString *text)
+{
+  NSUInteger rtl = 0, ltr = 0;
+  NSCharacterSet *letters = NSCharacterSet.letterCharacterSet;
+  NSCharacterSet *marks = NSCharacterSet.nonBaseCharacterSet;
+  for (NSUInteger i = 0; i < text.length;) {
+    UTF32Char c = [text characterAtIndex:i++];
+    if (CFStringIsSurrogateHighCharacter(c) && i < text.length) {
+      unichar low = [text characterAtIndex:i];
+      if (CFStringIsSurrogateLowCharacter(low)) {
+        c = CFStringGetLongCharacterForSurrogatePair(c, low);
+        i++;
+      }
+    }
+    if (c == 0x200E) return NSWritingDirectionLeftToRight;
+    if (c == 0x200F || c == 0x061C) return NSWritingDirectionRightToLeft;
+    if (![letters longCharacterIsMember:c] || [marks longCharacterIsMember:c]) continue;
+    BOOL isRTL = (c >= 0x0590 && c <= 0x08FF) || (c >= 0xFB1D && c <= 0xFDFF) ||
+                 (c >= 0xFE70 && c <= 0xFEFF) || (c >= 0x10800 && c <= 0x10FFF) ||
+                 (c >= 0x1E800 && c <= 0x1EEFF);
+    if (isRTL) rtl++; else ltr++;
+  }
+  if (rtl == 0 && ltr == 0) return NSWritingDirectionNatural;
+  return rtl > ltr ? NSWritingDirectionRightToLeft : NSWritingDirectionLeftToRight;
+}
