--- /dev/null
+++ b/android/src/main/java/com/swmansion/enriched/markdown/utils/text/MajorityTextDirection.kt
@@ -0,0 +1,43 @@
+package com.swmansion.enriched.markdown.utils.text
+
+import android.text.Spanned
+import android.text.TextDirectionHeuristic
+import com.swmansion.enriched.markdown.spans.CodeSpan
+import com.swmansion.enriched.markdown.spans.CodeBlockSpan
+import com.swmansion.enriched.markdown.spans.LinkPillSpan
+
+/** Resolve each paragraph from prose letters without changing the copied text. */
+object MajorityTextDirection : TextDirectionHeuristic {
+  override fun isRtl(text: CharSequence, start: Int, count: Int): Boolean {
+    var rtl = 0
+    var ltr = 0
+    var offset = start
+    val end = start + count
+    while (offset < end) {
+      val runEnd = if (text is Spanned) text.nextSpanTransition(offset, end, Any::class.java) else end
+      if (text is Spanned) {
+        val spans = text.getSpans(offset, offset + 1, Any::class.java)
+        val excluded = spans.firstOrNull { it is CodeSpan || it is CodeBlockSpan || it is LinkPillSpan }
+        if (excluded != null) {
+          offset = runEnd
+          continue
+        }
+      }
+      while (offset < runEnd) {
+        val codePoint = Character.codePointAt(text, offset)
+        offset += Character.charCount(codePoint)
+        if (codePoint == 0x200E) return false
+        if (codePoint == 0x200F || codePoint == 0x061C) return true
+        if (!Character.isLetter(codePoint)) continue
+        when (Character.getDirectionality(codePoint)) {
+          Character.DIRECTIONALITY_RIGHT_TO_LEFT, Character.DIRECTIONALITY_RIGHT_TO_LEFT_ARABIC -> rtl++
+          else -> ltr++
+        }
+      }
+    }
+    return rtl > ltr
+  }
+
+  override fun isRtl(text: CharArray, start: Int, count: Int): Boolean =
+    isRtl(String(text, start, count), 0, count)
+}
