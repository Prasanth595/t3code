{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalConsole": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "globalFetch": "off",
          "preferSchemaOverJson": "off",
          "nodeBuiltinImport": "off"
        }
      }
    ]
  },
  "include": ["src", "examples", "scripts"],
  // The browser runtime imports the live checkout ("@nofun/ui/*", "@nofun/kobra/*"); esbuild checks it.
  "exclude": ["src/runtime", "examples/*.tsx", "examples/canvas/*.tsx"]
}
