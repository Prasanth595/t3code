{
  "name": "T3 Code",
  "short_name": "T3 Code",
  "description": "A minimal GUI for coding agents.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#161616",
  "theme_color": "#161616",
  "icons": [
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New thread",
      "description": "Start a thread in the most recent project.",
      "url": "/",
      "icons": [
        {
          "src": "/shortcuts/new-thread-96.png",
          "type": "image/png",
          "sizes": "96x96",
          "purpose": "maskable"
        },
        {
          "src": "/shortcuts/new-thread-192.png",
          "type": "image/png",
          "sizes": "192x192",
          "purpose": "maskable"
        },
        {
          "src": "/shortcuts/new-thread-192.png",
          "type": "image/png",
          "sizes": "192x192",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Pull requests",
      "url": "/pull-requests",
      "icons": [
        {
          "src": "/shortcuts/pull-requests-96.png",
          "type": "image/png",
          "sizes": "96x96",
          "purpose": "maskable"
        },
        {
          "src": "/shortcuts/pull-requests-192.png",
          "type": "image/png",
          "sizes": "192x192",
          "purpose": "maskable"
        },
        {
          "src": "/shortcuts/pull-requests-192.png",
          "type": "image/png",
          "sizes": "192x192",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Settings",
