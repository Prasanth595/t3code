          "purpose": "maskable"
        },
        {
          "src": "/shortcuts/queue-192.png",
          "type": "image/png",
          "sizes": "192x192",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Tasks",
      "description": "Scheduled tasks of every machine.",
      "url": "/#/tasks",
      "icons": [
        {
          "src": "/shortcuts/tasks-96.png",
          "type": "image/png",
          "sizes": "96x96",
          "purpose": "maskable"
        },
        {
          "src": "/shortcuts/tasks-192.png",
          "type": "image/png",
          "sizes": "192x192",
