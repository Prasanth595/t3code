{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "t3-machine-map",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "map.tomcohen.dev", "custom_domain": true }],
  // The page bundle from `vp build`. The Worker runs first only for its own paths.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/connect", "/enroll", "/enroll/*", "/client/*", "/android"],
  },
  "durable_objects": {
    "bindings": [{ "name": "MAP", "class_name": "MachineMapObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MachineMapObject"] }],
  "vars": {
    "TEAM_DOMAIN": "tomcohen.cloudflareaccess.com",
    "ACCOUNT_ID": "0190d74990bca0aacde75809935dc721",
    // The Access app of the machine hostnames. MM-201 adds new machine tokens to its policy.
    "MACHINE_ACCESS_APP_ID": "91226391-b1d9-44f3-acb6-e49328b619a8",
    // Create the Access apps of the README, then replace these values before the first deploy.
    // The Worker refuses every owner and machine request while a value starts with REPLACE_.
    "PAGE_AUD": "68ee9b1548549a03783b692b36f3566a193e32d928870c217439b8784e1307df",
    "CONNECT_AUD": "ff3b6a766321e10ffa4762fed121de0303d8b1522d467dbad8645efb10825137",
    "CONNECT_ACCESS_APP_ID": "3879af70-5455-45d8-9723-1a2a51ae1051",
    // MM-213: the tunnel of a new machine is `t3-<slug>.<MACHINE_DOMAIN>` in this zone.
    "MACHINE_DOMAIN": "tomcohen.dev",
    "MACHINE_ZONE_ID": "7c7f4395b6cc34c7e530e32eb8196eea",
  },
  // Secrets (`wrangler secret put`): OWNER_EMAILS (required), SECRET_KEY (required for joins),
  // CF_API_TOKEN (optional), MACHINE_ACCESS_SUBJECTS (optional, MM-213).
}
