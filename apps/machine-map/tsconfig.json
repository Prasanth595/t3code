{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "WebWorker"],
    "types": ["@cloudflare/workers-types"],
    "plugins": [
      {
        "name": "@effect/language-service",
        // The Worker and the page are plain TypeScript, not Effect programs.
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalConsole": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "globalFetch": "off",
          "cryptoRandomUUID": "off",
          "preferSchemaOverJson": "off"
        }
      }
    ]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/ui", "src/sw"]
}
