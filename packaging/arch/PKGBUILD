# Maintainer: Henry <henry>
#
# Builds the desktop app and the standalone `t3` server from this checkout, so a
# rebuild always packages whatever is on disk, committed or not.
#
#   yay -Bi packaging/arch                        # desktop app + `t3` server
#   T3CODE_FORK_SKIP_CLI=1 yay -Bi packaging/arch # desktop app only (skips the
#                                                 # ~200 MB standalone server build)
#
# makepkg leaves src/, pkg/, and the package itself beside the PKGBUILD, where
# this repo ignores them.
#
# The checkout must be a git clone, because pkgver() reads its HEAD. The PKGBUILD
# assumes this file sits two levels below that checkout; elsewhere, point it:
#
#   T3CODE_FORK_REPO=/path/to/t3code yay -Bi <dir>
#
# `squashfs-root` extraction needs no FUSE. The deb that electron-builder also
# produces is thrown away; only the AppImage is packaged.

pkgname=t3code-fork
pkgver=0.1.3.r7990.g493aa15b61
pkgrel=1
pkgdesc='Desktop app and server for coding agents (Quinntyx fork)'
arch=('x86_64')
url='https://github.com/Quinntyx/t3code'
license=('MIT')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gdk-pixbuf2'
  'git'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libdrm'
  'libgcc'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
  'zlib'
)
# build-desktop-artifact.ts always pairs AppImage with a deb target, and
# electron-builder's bundled fpm needs the pre-2.0 libcrypt soname.
makedepends=('nodejs' 'git' 'rust' 'libxcrypt-compat' 'pnpm')
optdepends=(
  'openai-codex: use the system-installed Codex CLI'
  'github-cli: sign in and open pull requests from the app'
)
provides=("t3code=$pkgver" 't3')
conflicts=('t3code' 't3code-bin' 't3code-nightly-bin' 't3code-git')
options=('!strip' '!debug')
install=t3code-fork.install

# Resolve through the PKGBUILD rather than $startdir so a symlinked copy built
# from another directory still finds the checkout it belongs to.
_pkgdir=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]:-PKGBUILD}")")
_repo=${T3CODE_FORK_REPO:-$(realpath -- "$_pkgdir/../..")}

# Everything workspace-shaped (AppImage target, resource-monitor directory, CLI
# archive) is named after the x64 build; arch=('x86_64') keeps that honest.
_target_arch=x64

source=()
sha256sums=()

if [[ ! -d $_repo/apps/desktop ]]; then
  error "No t3code checkout at $_repo. Set T3CODE_FORK_REPO to one."
  exit 1
fi

pkgver() {
  if [[ -n $(git -C "$_repo" status --porcelain) ]]; then
    warning "Building from a dirty checkout; the package will not record those changes."
  fi
  printf '%s.r%s.g%s' \
    "$(node -p "require('$_repo/apps/desktop/package.json').version")" \
    "$(git -C "$_repo" rev-list --count HEAD)" \
    "$(git -C "$_repo" rev-parse --short HEAD)"
}

build() {
  # The repo's own release scripts shell out to workspace binaries (vp,
  # electron-builder), so they must be on PATH.
  export PATH="$_repo/node_modules/.bin:$PATH"
  if [[ ! -d $_repo/node_modules ]]; then
    # `vp` itself lives in node_modules, so a fresh clone cannot bootstrap with
    # it; the lockfile pins what `vp i` would install.
    ( cd "$_repo" && pnpm install --frozen-lockfile )
  fi

  cd "$_repo"
  node scripts/build-desktop-artifact.ts \
    --platform linux \
    --target AppImage \
    --arch "$_target_arch" \
    --output-dir "$srcdir/appimage"

  if [[ -z ${T3CODE_FORK_SKIP_CLI:-} ]]; then
    # build-cli-archive only assembles what already exists, so both bundles must be
    # rebuilt here or the package silently ships a stale server.
    vp run --filter t3 build
    # The host default refuses unless Node matches engines.node exactly; naming the
    # host as an explicit target skips that gate and needs no second toolchain.
    node apps/server/scripts/cli.ts build-exe --target linux-$_target_arch

    # The runtime archive expects resource-monitor/<platform>-<arch>/t3-resource-monitor.
    cargo build --locked --release --manifest-path native/resource-monitor/Cargo.toml
    install -Dm755 native/resource-monitor/target/release/t3-resource-monitor \
      "$srcdir/resource-monitor/linux-$_target_arch/t3-resource-monitor"

    node scripts/build-cli-archive.ts \
      --platform linux \
      --arch "$_target_arch" \
      --version "$(node -p "require('./apps/server/package.json').version")" \
      --resource-monitor-dir "$srcdir/resource-monitor" \
      --output-dir "$srcdir/cli"
  fi
}

package() {
  local appimage appdir serverdir
  appdir="$pkgdir/opt/$pkgname"
  serverdir="$pkgdir/opt/$pkgname-server"
  appimage=$(find "$srcdir/appimage" -maxdepth 1 -name '*.AppImage' -print -quit)
  if [[ -z $appimage ]]; then
    error 'electron-builder did not leave an AppImage behind.'
    return 1
  fi

  cd "$srcdir"
  chmod +x "$appimage"
  rm -rf squashfs-root
  "$appimage" --appimage-extract >/dev/null

  if [[ ! -x squashfs-root/AppRun || ! -f squashfs-root/chrome-sandbox ]]; then
    error 'The AppImage payload is missing its launcher or Chromium sandbox.'
    return 1
  fi

  install -d "$appdir"
  cp -a --no-preserve=ownership squashfs-root/. "$appdir/"
  chmod -R u=rwX,go=rX "$appdir"
  chmod 4755 "$appdir/chrome-sandbox"

  install -d "$pkgdir/usr/bin"
  ln -s "/opt/$pkgname/AppRun" "$pkgdir/usr/bin/t3code"

  # Icon lookup only sees sizes registered in hicolor's index.theme (max 512x512).
  local icon size
  for icon in squashfs-root/usr/share/icons/hicolor/*/apps/t3code.png; do
    size="${icon%/apps/t3code.png}"
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/${size##*/}/apps/t3code.png"
  done

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/t3code.desktop" <<'EOF'
[Desktop Entry]
Name=T3 Code (Fork)
Comment=Desktop app and server for coding agents
Exec=t3code %U
TryExec=t3code
Terminal=false
Type=Application
Icon=t3code
StartupWMClass=t3code
Categories=Development;
MimeType=x-scheme-handler/t3code;
EOF

  install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # `t3 update` and `t3 uninstall` refuse on a package-managed install and quote this.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/$pkgname/rebuild-command" <<EOF
yay -Bi $startdir
EOF

  if [[ -z ${T3CODE_FORK_SKIP_CLI:-} ]]; then
    local archive payload
    archive=$(find "$srcdir/cli" -maxdepth 1 -name 't3-*.tar.gz' -print -quit)
    if [[ -z $archive ]]; then
      error 'build-cli-archive did not leave a t3-*.tar.gz behind.'
      return 1
    fi
    install -d "$srcdir/cli-extract"
    tar -xzf "$archive" -C "$srcdir/cli-extract"
    payload=$(find "$srcdir/cli-extract" -maxdepth 1 -mindepth 1 -type d -print -quit)
    install -d "$serverdir"
    cp -a --no-preserve=ownership "$payload/." "$serverdir/"
    chmod -R u=rwX,go=rX "$serverdir"
    chmod 755 "$serverdir/t3"
    # The runtime resolves client/ and node_modules/ beside its own binary, so
    # the executable is linked, never copied.
    ln -s "/opt/$pkgname-server/t3" "$pkgdir/usr/bin/t3"
  fi
}
